  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Electron",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/electron/cli.js",
      "args": ["."],
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node"
    },
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    }
  ]
}
